# Copy to .env and fill in your own keys. Never commit the real .env.
#
# The standalone scripts (scripts/*.py) load this file automatically via
# python-dotenv. The web app reads the process environment instead, so export
# these before starting it:
#
#   set -a; source .env; set +a
#   web/start_all.sh

# --- Required ---

# The Blue Alliance API key — event schedules, team lists, match results.
# Create one at https://www.thebluealliance.com/account (Read API Keys).
TBA_API_KEY=your-tba-read-key

# --- Optional ---

# Hugging Face read token — model downloads (avoids rate limits; required for
# gated repos such as facebook/sam3.1 if you use the SAM3 tracking backend).
# Create one (role: Read) at https://huggingface.co/settings/tokens
#HF_TOKEN=hf_...

# Roboflow API key — only needed to rebuild the bumper-detector training
# datasets via scripts/download_bumper_datasets.py.
# Find it at https://app.roboflow.com -> Settings -> API Keys.
#ROBOFLOW_API=...

# Cloud VLM keys — only needed for the optional cloud team-number readers and
# the baseline evaluation scripts (scripts/gemini_*.py). The default local
# reader (Qwen3-VL via vLLM) needs none of these.
#ANTHROPIC_API_KEY=sk-ant-...
#DEEPSEEK_API=sk-...
#GEMINI_API_KEY=...
