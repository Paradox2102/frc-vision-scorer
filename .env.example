# Copy to .env and fill in your own keys. Never commit the real .env.
# The web app and the scripts both load this file automatically.

# --- Required ---

# The Blue Alliance read key: event schedules, rosters, match videos.
# Create one at https://www.thebluealliance.com/account (Read API Keys).
TBA_API_KEY=your-tba-read-key

# Hugging Face read token. SAM 3 (the robot tracker) is a gated model: request
# access to https://huggingface.co/facebook/sam3, then create a token (role:
# Read) at https://huggingface.co/settings/tokens. Without it, tracking falls
# back to a plain Kalman tracker.
HF_TOKEN=hf_...

# Jev (TypeSafe) API token: live bumper reads, the hindsight lineup matching,
# and AprilTag checks during calibration. Without it, jobs run but robots stay
# unnamed.
JEV_TYPESAFE_API_TOKEN=...

# --- Optional: renting cloud GPUs (deploy/runpod/runpod_cli.py) ---
# These stay on your machine; they are never copied to a rented server.
#RUNPOD_API=...
#VASTAI_API=...

# --- Optional: other readers, data tools ---

# YouTube cookies file for yt-dlp, if downloads get bot-blocked.
#YTDLP_COOKIES_FILE=/path/to/cookies.txt

# Cloudflare Workers AI reader (TEAM_READER=clef).
#CLOUDFLARE_ACCOUNT_ID=...
#CLOUDFLARE_API_TOKEN=...

# Cloud LLM readers used only by benchmark/evaluation scripts.
#ANTHROPIC_API_KEY=sk-ant-...
#DEEPSEEK_API=sk-...

# Roboflow: only to rebuild the bumper-detector training datasets
# (scripts/download_bumper_datasets.py).
#ROBOFLOW_API=...

# RoboRecon push target (POST {ROBORECON_URL}/api/integrations/vision-scouting)
ROBORECON_URL=https://roborecon.net
ROBORECON_TOKEN=
# Push auto paths to RoboRecon after every completed match analysis (0/1)
ROBORECON_AUTO_PUSH=0
# Metrics auto-pushed (comma list); default auto_paths
#ROBORECON_AUTO_PUSH_METRICS=auto_paths
