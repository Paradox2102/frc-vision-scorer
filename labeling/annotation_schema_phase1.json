{
  "schema_version": "phase1.v1",
  "task_type": "frame_annotation",
  "goal": "Per-team made-shot counting into center container only",
  "required_task_metadata": {
    "video_id": "string",
    "frame_index": "integer >= 0",
    "timestamp_s": "number >= 0",
    "image": "local-or-remote image path"
  },
  "region_labels": [
    {
      "name": "robot",
      "description": "Robot body for detection/tracking and shot attribution",
      "attributes": {
        "team_number": "string|null",
        "alliance": [
          "red",
          "blue",
          "unknown"
        ],
        "occlusion": [
          "clear",
          "partial",
          "heavy",
          "unknown"
        ]
      }
    },
    {
      "name": "bumper_number_roi",
      "description": "Tight ROI around visible bumper number text",
      "attributes": {
        "team_number": "string|null",
        "occlusion": [
          "clear",
          "partial",
          "heavy",
          "unknown"
        ]
      }
    },
    {
      "name": "center_goal_roi",
      "description": "Center container opening area where made shots are counted",
      "attributes": {
        "goal_id": "center_container"
      }
    },
    {
      "name": "fuel_ball",
      "description": "Optional ball localization for goal-entry model bootstrapping"
    }
  ],
  "frame_level_fields": {
    "made_shot_event": [
      "none",
      "made_shot_center"
    ],
    "shot_team_number": "string|null",
    "shot_ball_track_id": "string|null",
    "shot_confidence": [
      "high",
      "medium",
      "low",
      "unknown"
    ]
  },
  "export_contract": {
    "format": "jsonl",
    "record_keys": [
      "task_id",
      "video_id",
      "frame_index",
      "timestamp_s",
      "image_path",
      "regions",
      "shot_event"
    ],
    "bbox_coordinate_system": "normalized_xywh_0_to_1"
  }
}
